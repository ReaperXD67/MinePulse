POSTGRES_DB="karixmc"
POSTGRES_USER="karixmc"
POSTGRES_PASSWORD="generate-a-long-random-database-password"
REDIS_PASSWORD="generate-a-different-long-random-redis-password"
DATABASE_URL="postgresql://karixmc:password@postgres:5432/karixmc"
DATABASE_POOL_MAX="20"
DATABASE_CONNECT_TIMEOUT_MS="5000"
DATABASE_IDLE_TIMEOUT_MS="30000"
REDIS_URL="redis://:password@redis:6379"
REDIS_REQUIRED="true"
REDIS_CONNECT_TIMEOUT_MS="2000"

AUTH_SECRET="generate-at-least-48-random-characters"
PLUGIN_SECRET_ENCRYPTION_KEY="generate-a-different-48-character-secret"
AUTH_COOKIE_NAME="karixmc_session"
AUTH_COOKIE_SECURE="true"
APP_BASE_URL="https://your-domain.example"
HEALTHCHECK_TOKEN="generate-an-independent-healthcheck-token"
PAYMENTS_ENABLED="false"
EMAIL_REQUIRED="true"
# Resend free SMTP relay: create a sending API key, then replace only the password below.
# Keep the API key in this untracked production file; never commit the real value.
SMTP_URL="smtps://resend:re_replace_with_resend_api_key@smtp.resend.com:465"
EMAIL_FROM="KarixMC <no-reply@your-domain.example>"
ADMIN_2FA_REQUIRED="true"
ACCOUNT_MFA_ENCRYPTION_KEY="generate-a-third-independent-48-character-secret"

MEDIA_HOST_PATH="/var/lib/karixmc/media"
MEDIA_ROOT="/app/storage/media"
SHOWCASE_DATA_ROOT="/var/lib/karixmc/showcase"
NEXT_PUBLIC_DISCORD_URL="https://discord.gg/your-invite"
NEXT_PUBLIC_LEGAL_NAME="KarixMC"
NEXT_PUBLIC_PRIVACY_EMAIL="privacy@your-domain.example"
NEXT_PUBLIC_LEGAL_ADDRESS=""

BACKUP_DIRECTORY="/var/backups/karixmc"
BACKUP_RETENTION_DAYS="14"
BACKUP_AGE_RECIPIENT=""
BACKUP_REMOTE=""
ALERT_WEBHOOK_URL=""
DEPLOYMENT_MODE="docker"
HEALTHCHECK_BASE_URL=""
