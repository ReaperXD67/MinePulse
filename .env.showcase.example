SHOWCASE_OWNER_EMAIL="karixai@proton.me"
SHOWCASE_PUBLIC_HOST="karixmc.pl"
SHOWCASE_API_BASE_URL="https://karixmc.pl"
SHOWCASE_DATA_ROOT="/var/lib/karixmc/showcase"
SHOWCASE_PLUGIN_ROOT="/var/lib/karixmc/showcase-plugins"
SHOWCASE_TIMEZONE="UTC"
SHOWCASE_ONLINE_MODE="FALSE"
SHOWCASE_ENFORCE_SECURE_PROFILE="FALSE"
SHOWCASE_SKYFORGE_SECRET="generate-a-unique-random-secret-with-at-least-32-characters"
SHOWCASE_EMBER_SECRET="generate-a-second-unique-random-secret-with-at-least-32-characters"
SHOWCASE_VOIDCRAFT_SECRET="generate-a-third-unique-random-secret-with-at-least-32-characters"
SHOWCASE_RCON_PASSWORD="generate-a-fourth-unique-random-secret"
SHOWCASE_AUTH_DB_PASSWORD="generate-a-fifth-unique-random-secret"
