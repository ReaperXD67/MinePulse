limit_req_zone $binary_remote_addr zone=karixmc_general:20m rate=20r/s;
limit_req_zone $binary_remote_addr zone=karixmc_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=karixmc_plugin:20m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=karixmc_connections:10m;

upstream karixmc_app {
    least_conn;
    server 127.0.0.1:3000;
    server 127.0.0.1:3001;
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://__DOMAIN__$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__ www.__DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    client_max_body_size 8m;
    keepalive_timeout 65;
    limit_conn karixmc_connections 30;
    limit_req_status 429;
    limit_conn_status 429;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    location = /api/health/live {
        limit_req zone=karixmc_general burst=10 nodelay;
        proxy_pass http://karixmc_app;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/auth/ {
        limit_req zone=karixmc_auth burst=10 nodelay;
        proxy_pass http://karixmc_app;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/plugin/ {
        limit_req zone=karixmc_plugin burst=120 nodelay;
        proxy_pass http://karixmc_app;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering on;
    }

    location /api/account/media {
        limit_req zone=karixmc_general burst=5 nodelay;
        proxy_pass http://karixmc_app;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        limit_req zone=karixmc_general burst=60 nodelay;
        proxy_pass http://karixmc_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_hide_header X-Powered-By;
    }
}
