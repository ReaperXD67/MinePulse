{
  "name": "minepulse",
  "version": "0.1.0",
  "private": true,
  "description": "Minecraft server marketplace with verified playtime rewards, owner campaigns, and admin controls.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "infra:up": "docker compose -f docker-compose.infrastructure.yml up -d",
    "infra:down": "docker compose -f docker-compose.infrastructure.yml down",
    "infra:logs": "docker compose -f docker-compose.infrastructure.yml logs -f postgres redis",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:demo": "cross-env ALLOW_DEMO_SEED=true prisma db seed",
    "db:seed:production": "tsx prisma/seed-production.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:import-sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "production:validate": "tsx scripts/validate-production-env.ts",
    "email:check": "tsx scripts/check-smtp.ts",
    "showcase:bootstrap": "tsx scripts/bootstrap-showcase.ts",
    "showcase:audit": "tsx scripts/showcase-audit.ts",
    "production:load-smoke": "node scripts/load-smoke.mjs",
    "production:ui-audit": "tsx scripts/production-ui-audit.ts",
    "security:encrypt-plugin-secrets": "tsx scripts/encrypt-plugin-secrets.ts",
    "assets:generate": "node scripts/generate-assets.mjs",
    "game:test:up": "docker compose -f docker-compose.game-test.yml up -d",
    "game:test:logs": "docker compose -f docker-compose.game-test.yml logs -f paper",
    "game:test:status": "docker exec minepulse-paper-test rcon-cli plugins",
    "game:test:down": "docker compose -f docker-compose.game-test.yml down -v",
    "test:admin-campaign-grant": "tsx scripts/admin-campaign-grant-audit.ts",
    "test:admin-directory": "tsx scripts/admin-directory-audit.ts",
    "test:admin-fleet": "tsx scripts/admin-fleet-policy-audit.ts",
    "test:plugin-heartbeat": "tsx scripts/plugin-heartbeat-audit.ts",
    "test:owner-live-state": "tsx scripts/owner-server-live-audit.ts",
    "test:server-removal": "tsx scripts/server-removal-audit.ts",
    "test:marketplace-guardrails": "tsx scripts/marketplace-guardrails-audit.ts",
    "test:minecraft-unlink": "tsx scripts/minecraft-unlink-audit.ts",
    "test:auth": "tsx scripts/auth-audit.ts",
    "test:account-security": "tsx scripts/account-security-audit.ts",
    "test:security-boundaries": "tsx scripts/security-boundary-audit.ts",
    "test:premium-order": "tsx scripts/premium-order-audit.ts",
    "test:account-ban": "tsx scripts/account-ban-audit.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.0",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.20.0",
    "next": "^16.2.12",
    "nodemailer": "^9.0.3",
    "otpauth": "^9.5.1",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "redis": "^6.2.0",
    "sharp": "^0.35.3",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.184.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "playwright": "^1.61.0",
    "prisma": "^7.9.1",
    "sql.js": "^1.14.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
